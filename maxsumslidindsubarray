import java.util.Scanner;
class Main {
    public static void main(String[] args) {
     Scanner sc = new Scanner(System.in);
        int sum =0 ;
      
     int n =sc.nextInt();
        int[] a = new int[n];
    int k=sc.nextInt();
         for(int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }
        for(int i=0;i<k;i++){
            sum = sum +a[i];
        }
       int max = sum;
        for(int i=k;i<n;i++){
            sum = sum-a[i-k]+a[i];
            max = Math.max(sum,max);
        }
        System.out.print(max);
    }
    }
