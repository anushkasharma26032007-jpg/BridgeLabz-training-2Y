import java.util.Scanner;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n];

        for(int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        int k = sc.nextInt();

        int sum = 0;
        int maxlen = 0;
        int left = 0;

        for(int right = 0; right < n; right++) {

            sum += a[right];

            while(sum > k) {
                sum -= a[left];
                left++;
            }

            maxlen = Math.max(maxlen, right - left + 1);
        }

        System.out.print(maxlen);
    }
}
