import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
     int n= sc.nextInt();
        int [] a = new int[n];
        for(int i=0;i<n;i++){
            a[i]= sc.nextInt();
        }
        int sum =0;
        int k =sc.nextInt();
        for(int i=0;i<k;i++){
            sum = sum + a[i];
        }
        int max =sum;
        for(int i=k;i<n;i++){
            sum =sum -a[i-k]+a[i];
            max =Math.max(max,sum);
        }
        double average = (double) max / k;
        System.out.print(average);
    }
    }
