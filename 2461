class Solution {
    public long maximumSubarraySum(int[] nums, int k) {
      HashSet<Integer>  set = new HashSet<>();
      long sum =0 ;
      long max =0;
      for(int i=0;i<k;i++){
        set.add(nums[i]);
        sum += nums[i];
      }
      if(set.size()==k){
        max=sum;
      }
      for(int right=k;right<nums.length;right++){
        set.add(nums[right]);
        set.remove(nums[right-k]);
         sum += nums[right];
            sum -= nums[right - k];

        if(set.size()==k){
        max = Math.max(max,sum);
        }
      }
     
      return max;
    }
}
