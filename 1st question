import java.util.*;
class main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int k  = sc.nextInt();
        int []a = new int[n];
        for(int i=0;i<n;i++){
            a[i]= sc.nextInt();
        }
        for(int i =0;i<=n-k;i++){
            HashSet<Integer> set = new HashSet<>();
            for(int j =i;j<i+k;j++){
                set.add(a[j]);
            }
            if(set.size()==0){
                System.out.print("-1");
            }else{
                System.out.print(set.size()+" ");
            }
        }
    }
}
